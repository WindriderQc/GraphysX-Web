From 5123c35c86a781b70cd67f8bebaf01347bdf1bfe Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 28 Jul 2026 01:59:42 +0000
Subject: [PATCH 2/5] feat(humans): Level 2's recorded iNumHuman = 10 stands,
 and two stale records correct
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

levelList.xml requests ten human proxies for Level 2. The record refused them
('no crowd entity exists in the v2 vocabulary') — a claim stale since crowd-r1.
The materialiser now honours the recorded count with actual vocabulary: a
wandering crowd (no pursuers — the archive requested ambient humans, not a
hunt) confined to the arena. The archived spawn scatter/seed is unrecoverable,
so placement is the crowd system's own, and the deviation is renamed
humans-placed-not-positioned to say exactly that.

best-time-not-shown corrected the same way: the win panel's medal scale judges
against the archived ScoreBest (ballz-play.ts::archiveReferenceMs) since the
scoreboard landed, so the entry now records the honest shape — the time does
real work as a medal threshold rather than being displayed as the recovered
figure.

Verified: smoke-archive-levels asserts Level 2 carries exactly ten humans and
Level 1 exactly none.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01AjMX8NeAJ88Biso5vpBsRJ
---
 scripts/smoke-archive-levels.mjs |  5 +++++
 src/archive-ballz-levels.ts      | 21 ++++++++++++++-------
 src/ballz-level-scene.ts         | 22 ++++++++++++++++++++++
 3 files changed, 41 insertions(+), 7 deletions(-)

diff --git a/scripts/smoke-archive-levels.mjs b/scripts/smoke-archive-levels.mjs
index 35276ad..086519c 100644
--- a/scripts/smoke-archive-levels.mjs
+++ b/scripts/smoke-archive-levels.mjs
@@ -212,6 +212,7 @@ try {
         floorRepeat: floor?.material.texture?.repeat ?? null,
         wallTexture: wall?.material.texture?.id ?? null,
         companionPosts: api.query({ tag: "companion-post" }).map((post) => ({ id: post.id, physics: post.physics?.mode })),
+        humans: api.query({ ids: ["ballz-humans"] })[0]?.crowd?.count ?? 0,
         entities: api.state()?.entities.length ?? 0,
         rulesArmed: !!api.rules.status(),
         collectibleCount: api.rules.status()?.collectibleCount ?? 0,
@@ -233,6 +234,10 @@ try {
       && built.floorNormalTexture === expectedSurface.normal
       && JSON.stringify(built.floorRepeat) === JSON.stringify(expectedSurface.repeat)
       && built.wallTexture === expectedSurface.wall, { expected: expectedSurface, built });
+    // Level 2's recorded `iNumHuman` = 10 is honoured as a wandering crowd; Level 1 records
+    // zero humans and must not gain any.
+    const expectedHumans = record.id === "archive-ballz-level2" ? 10 : 0;
+    check("the recorded iNumHuman count is honoured", built.humans === expectedHumans, { got: built.humans, expected: expectedHumans });
     check("both lowercase companion posts are physical scene entities", built.companionPosts.length === 2
       && built.companionPosts.every((post) => post.physics === "static"), built.companionPosts);
 
