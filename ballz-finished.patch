+    case 0: return [1, -b, -a];
+    case 1: return [-1, -b, a];
+    case 2: return [a, 1, b];
+    case 3: return [a, -1, -b];
+    case 4: return [a, -b, 1];
+    default: return [-a, -b, -1];
+  }
