server {
    listen 80;
    listen [::]:80;
    server_name graphysx.specialblend.ca;

    root /var/www/html/graphysx/current;
    index index.html;

    # The app ships ~750 KB of JS on first load, nearly all of it three.js. Compressing
    # it is the single largest transfer win available and costs nothing to enable.
    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/wasm
        image/svg+xml;

    # Vite emits content-hashed filenames under /assets/, so those are safe to cache
    # forever. A release that changes a file changes its name.
    location /assets/ {
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The shell must never be cached, or clients keep booting the previous release
    # after a deploy has already swapped the symlink.
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # --- the scene store -------------------------------------------------------------------
    #
    # Same-origin on purpose. The alternative — a second hostname — needs its own certificate,
    # a CORS allowlist, and preflights on every mutating request; and an `http://` store on an
    # `https://` page is blocked outright as mixed content, which is the wall any LAN-address
    # store hits immediately. Proxying under a path costs none of that: the browser sees one
    # origin, TLS is the one certbot already issued, and `GRAPHYSX_STORE_ORIGIN` has nothing
    # to allow because nothing is cross-origin.
    #
    # Enable by pointing the app at it: build with VITE_GRAPHYSX_STORE_URL=/store. Without
    # that, nothing requests these paths and this block is inert.
    #
    # The upstream is the store from `npm run serve:scenes`, which MUST run with
    # GRAPHYSX_STORE_TOKEN set — live sessions refuse to run without one (they answer 503
    # rather than inherit the tokenless LAN mode). See docs/DEPLOYING_THE_STORE.md.
    location /store/ {
        proxy_pass http://127.0.0.1:8788/;
        proxy_http_version 1.1;

        # Server-Sent Events. Without these three the live session and scene streams still
        # "work" in every test that only checks status codes, and then deliver nothing until
        # the connection closes — nginx buffers the response, and a stream that is buffered is
        # a stream that does not exist. The store also sends `X-Accel-Buffering: no`, which
        # nginx honours; this is the belt to that suspenders.
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Connection "";

        # A session stream is open for as long as someone is collaborating. The default 60s
        # read timeout would sever it once a minute, and the client would dutifully reconnect
        # once a minute, forever.
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Ghost uploads and scene documents. The store caps bodies itself (8 MiB for scenes,
        # 256 KiB for operations); this only has to be no smaller than the largest of them.
        client_max_body_size 16m;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
